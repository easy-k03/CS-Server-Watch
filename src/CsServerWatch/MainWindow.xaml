<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CsServerWatch.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CS Server Watch">
    <Grid Background="#100E0C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="40" Background="#100E0C">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="28" Height="28" Margin="16,0,0,0" CornerRadius="8" Background="#E0B15A" VerticalAlignment="Center">
                <TextBlock Text="CS" FontSize="11" FontWeight="Bold" Foreground="#1A1208" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="CS Server Watch" Margin="10,0,148,0" VerticalAlignment="Center" Foreground="#F6F1E7" FontWeight="SemiBold" />
            <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="#3C342C" />
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="1" Background="#100E0C" />
    </Grid>
</Window>
